<canvas class="particle-canvas"></canvas>

<script is:inline>
	const initParticleEffect = () => {
		if (window.__globalParticleEffectInit) return;
		window.__globalParticleEffectInit = true;

		const canvas = document.querySelector('.particle-canvas');
		if (!canvas) return;
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const usesCoarsePointer = window.matchMedia('(pointer: coarse)').matches;
		if (prefersReducedMotion || usesCoarsePointer) {
			canvas.hidden = true;
			return;
		}
		
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		let width, height;
		let particleGateEnabled = true;
		const inactivePointer = { x: -1000, y: -1000 };

		// Handle high-DPI displays for sharper particles and correct coordinates
		const setCanvasSize = () => {
			width = window.innerWidth;
			height = window.innerHeight;
			// Use devicePixelRatio to ensure particles render sharply and correctly on Retina displays
			const dpr = window.devicePixelRatio || 1;
			canvas.width = width * dpr;
			canvas.height = height * dpr;
			ctx.scale(dpr, dpr);
		};

		setCanvasSize();

		let particles = [];
		let animationFrameId = 0;
		let pointer = { ...inactivePointer };
		let mouse = { ...inactivePointer };
		let lastMouse = { ...inactivePointer };

		window.addEventListener('resize', setCanvasSize);

		const clearParticles = () => {
			particles = [];
			mouse = { ...inactivePointer };
			lastMouse = { ...inactivePointer };
			ctx.clearRect(0, 0, width, height);
		};

		const setParticleGateEnabled = (enabled) => {
			if (particleGateEnabled === enabled) return;
			particleGateEnabled = enabled;
			if (!particleGateEnabled) {
				clearParticles();
			}
		};

		const syncParticleGate = () => {
			const isHomepage = window.location.pathname === '/';
			if (!isHomepage) {
				setParticleGateEnabled(true);
				return;
			}

			const heroSection = document.querySelector('.home-hero');
			if (!heroSection) {
				setParticleGateEnabled(true);
				return;
			}

			const heroRect = heroSection.getBoundingClientRect();
			const pointerInsideHero = (
				pointer.x >= heroRect.left &&
				pointer.x <= heroRect.right &&
				pointer.y >= heroRect.top &&
				pointer.y <= heroRect.bottom
			);

			setParticleGateEnabled(!pointerInsideHero);
		};

		const updateMouse = (e) => {
			pointer.x = e.clientX || (e.touches && e.touches[0].clientX);
			pointer.y = e.clientY || (e.touches && e.touches[0].clientY);
			syncParticleGate();
			if (!particleGateEnabled) return;

			lastMouse.x = mouse.x;
			lastMouse.y = mouse.y;
			
			// Always calculate relative to the viewport
			mouse.x = pointer.x;
			mouse.y = pointer.y;
			
			// Initialize lastMouse on first move to prevent long lines
			if (lastMouse.x === -1000) {
				lastMouse.x = mouse.x;
				lastMouse.y = mouse.y;
			}
			
			// Calculate distance and velocity
			let dx = mouse.x - lastMouse.x;
			let dy = mouse.y - lastMouse.y;
			let dist = Math.sqrt(dx * dx + dy * dy);
			
			// Add particles interpolated along the path to ensure smooth trailing
			let count = Math.min(Math.floor(dist / 5) + 1, 10);
			for(let i = 0; i < count; i++) {
				let ix = lastMouse.x + dx * (i / count);
				let iy = lastMouse.y + dy * (i / count);
				particles.push(new Particle(ix, iy, dx, dy));
			}
			if (!animationFrameId && particles.length > 0) {
				animationFrameId = requestAnimationFrame(render);
			}
		};

		window.addEventListener('mousemove', updateMouse);
		window.addEventListener('touchmove', updateMouse, { passive: true });

		class Particle {
			constructor(x, y, dx, dy) {
				this.x = x;
				this.y = y;
				// Base velocity inheriting from mouse movement + some random spread
				this.vx = dx * 0.05 + (Math.random() - 0.5) * 4;
				this.vy = dy * 0.05 + (Math.random() - 0.5) * 4;
				this.size = Math.random() * 4 + 1.5;
				this.life = 1;
				this.decay = Math.random() * 0.01 + 0.015;
				// Dynamic cool palette: cyan to purple (Hue 200 - 280)
				this.hue = Math.random() * 80 + 200; 
			}
			update() {
				this.x += this.vx;
				this.y += this.vy;
				// Friction
				this.vx *= 0.95;
				this.vy *= 0.95;
				// Shrink
				this.size *= 0.93;
				// Fade out
				this.life -= this.decay;
			}
			draw(ctx) {
				ctx.beginPath();
				ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
				ctx.fillStyle = `hsla(${this.hue}, 100%, 65%, ${this.life})`;
				ctx.fill();
			}
		}

		function render() {
			// Clear frame
			ctx.clearRect(0, 0, width, height);
			
			// Use additive blending to make overlapping particles glow
			ctx.globalCompositeOperation = 'lighter';
			
			for (let i = particles.length - 1; i >= 0; i--) {
				let p = particles[i];
				p.update();
				if (p.life <= 0 || p.size <= 0.1) {
					particles.splice(i, 1);
				} else {
					p.draw(ctx);
				}
			}
			
			ctx.globalCompositeOperation = 'source-over';
			if (particles.length === 0) {
				animationFrameId = 0;
				return;
			}
			animationFrameId = requestAnimationFrame(render);
		}
		
		syncParticleGate();
		document.addEventListener('astro:page-load', syncParticleGate);
		window.addEventListener('scroll', syncParticleGate, { passive: true });
		window.addEventListener('resize', syncParticleGate);
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initParticleEffect, { once: true });
	} else {
		initParticleEffect();
	}
</script>

<style>
/* 
	Particle canvas full screen and fixed
*/
.particle-canvas {
	position: fixed;
	top: 0;
	left: 0;
	/* Use 100% instead of 100vw/vh to prevent scrollbar-induced layout shifts */
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: 9999;
}

/* Hide on mobile devices generally to save performance and prevent UX issues */
@media (max-width: 768px) {
	.particle-canvas {
		display: none;
	}
}

@media (prefers-reduced-motion: reduce), (pointer: coarse) {
	.particle-canvas {
		display: none;
	}
}
</style>
