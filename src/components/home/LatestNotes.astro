---
import type { CollectionEntry } from 'astro:content';
import { latestNotesIntro } from '../../data/homepage';
import { formatIsoDate } from '../../data/site-utils';
import LocalizedText from '../LocalizedText.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<div class="latest-notes">
  <div class="latest-notes__header">
    <div>
      <p class="latest-notes__eyebrow font-type">{latestNotesIntro.eyebrow}</p>
      <h2 id="latest-notes-heading"><LocalizedText zh={latestNotesIntro.title} en={latestNotesIntro.titleEn} /></h2>
      <p><LocalizedText zh={latestNotesIntro.description} en={latestNotesIntro.descriptionEn} /></p>
    </div>
    <a href="/blog" class="latest-notes__link"><LocalizedText zh="查看全部文章" en="View all writing" /></a>
  </div>

  <div class="latest-notes__grid">
    {posts.map((post) => {
      const tags = post.data.tags?.slice(0, 3) ?? [];
      const description = post.data.description || '围绕产品和实验的构建记录。';

      return (
        <a href={`/blog/${post.slug}`} class="latest-note">
          <div class="latest-note__meta">
            <span>{formatIsoDate(post.data.publishDate)}</span>
            {post.data.read && <span>{post.data.read} min</span>}
          </div>
          <h3><LocalizedText zh={post.data.title} en={post.data.title_en || post.data.title} /></h3>
          <p><LocalizedText zh={description} en={post.data.description_en || post.data.description || 'A build note from the independent product studio.'} /></p>
          {tags.length > 0 && (
            <div class="latest-note__tags">
              {tags.map((tag) => <span>{tag}</span>)}
            </div>
          )}
        </a>
      );
    })}
    {posts.length === 0 && (
      <article class="latest-note latest-note--placeholder">
        <div class="latest-note__meta"><LocalizedText zh="内容占位" en="Content placeholder" /></div>
        <h3><LocalizedText zh="第一篇构建日志正在准备" en="The first build note is in progress" /></h3>
        <p><LocalizedText zh="这里将展示文章标题、摘要、阅读时长和标签。" en="This card demonstrates the future title, summary, reading time, and tag layout." /></p>
      </article>
    )}
  </div>

</div>

<style lang="scss">
  .latest-notes__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    width: 100%;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .latest-notes__header > div {
    max-width: 42rem;
  }

  .latest-notes__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-400);
    letter-spacing: 0.14em;
    font-size: 0.8rem;
  }

  .latest-notes__header h2 {
    margin: 0;
    font-size: var(--font-size-section-title);
    color: var(--color-100);
  }

  .latest-notes__header p {
    margin: 0.8rem 0 0;
    line-height: 1.75;
    color: var(--color-300);
  }

  .latest-notes__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .latest-note {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 24px;
    text-decoration: none;
    background: var(--color-white);
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  :root.theme-dark .latest-note {
    background: var(--color-999);
  }

  .latest-note:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary-main);
  }

  .latest-note--placeholder {
    border-style: dashed;
  }

  .latest-note__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-size: 0.82rem;
    color: var(--color-400);
  }

  .latest-note h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.4;
    color: var(--color-100);
  }

  .latest-note p {
    margin: 0;
    color: var(--color-300);
    line-height: 1.75;
  }

  .latest-note__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
  }

  .latest-note__tags span {
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--color-400);
    font-size: 0.78rem;
  }

  .latest-notes__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 148px;
    padding: 0.95rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--color-100);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .latest-notes__link:hover {
    border-color: var(--color-primary-main);
  }

  @media (max-width: 980px) {
    .latest-notes__header {
      flex-direction: column;
      align-items: flex-start;
    }

    .latest-notes__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
