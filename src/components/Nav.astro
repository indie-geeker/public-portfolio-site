---
// import Icon, { Props as IconProps } from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import Effect from "../effects/Effect.astro";
import {nav} from '../data/content';
import NavMobile from "../components/NavMobile.astro";
import LocaleToggle from './LocaleToggle.astro';
import LocalizedText from './LocalizedText.astro';

const isHomePage = Astro.url.pathname === '/';
const isNavItemActive = (href: string) => (
	Astro.url.pathname === href ||
	(href !== '/' && Astro.url.pathname.startsWith(href)) ||
	(href === '/project' && Astro.url.pathname.startsWith('/detail/'))
);
---

<nav data-scroll-glass-nav>
	<div class="container nav-wrapper">
		<div class="menu-header">
				<div class="site-title">
					<a
						href="/"
						class:list={[
							'author',
							{
								'author--nav-avatar-hidden': isHomePage,
							},
						]}
						data-nav-avatar
					>
						<figure
							class:list={[
								'avatar',
								{
									'avatar--home-hidden': isHomePage,
								},
							]}
						>
							<img class="avatar__img"
								src={nav.avatar} alt="IndieGeeker / 独立极客"
								draggable="false">
						</figure>
					</a>
			</div>
		</div>
		<div id="menu-content">
			<div class="menu-footer pc-nav">
				<ul class="nav-items">
					{nav.items?.map(item => (
						<li>
							<a
								aria-current={isNavItemActive(item.href) ? 'page' : undefined}
								 class:list={[
									'link',
									{
										active: isNavItemActive(item.href),
									},
								]}
								href={item.href}
								target={item.target || '_self'}
							>
								<LocalizedText zh={item.label} en={item.labelEn} />
							</a>
						</li>
    				))}
				</ul>
				<div class="theme-toggle" style="transform:scale(0.75)">
					<ThemeToggle />
				</div>
				<LocaleToggle />
			</div>
			<NavMobile/>
		</div>
	</div>
</nav>
<Effect transition:persist/>
<script>
	declare global {
		interface Window {
			__scrollGlassNavInit?: boolean;
		}
	}

	const initScrollGlassNav = () => {
		if (window.__scrollGlassNavInit === true) return;
		window.__scrollGlassNavInit = true;

		let rafId = 0;
		const maxScroll = 120;
		const getScrollTop = () => {
			return (
				window.scrollY ||
				window.pageYOffset ||
				document.documentElement.scrollTop ||
				document.body.scrollTop ||
				document.scrollingElement?.scrollTop ||
				0
			);
		};

		const syncScrollGlassNav = () => {
			const nav = document.querySelector('[data-scroll-glass-nav]') as HTMLElement | null;
			if (!nav) return;

			const progress = Math.min(getScrollTop() / maxScroll, 1);
			nav.style.setProperty('--nav-scroll-progress', progress.toFixed(3));
			nav.style.setProperty('--nav-surface-alpha', (progress * 0.78).toFixed(3));
			nav.style.setProperty('--nav-border-alpha', (progress * 0.5).toFixed(3));
			nav.style.setProperty('--nav-shadow-alpha', (progress * 0.14).toFixed(3));
			nav.style.setProperty('--nav-blur-strength', `${Math.round(progress * 14)}`);
			nav.classList.toggle('nav--scrolled', progress > 0.04);
		};

		const requestNavSync = () => {
			if (rafId) return;
			rafId = window.requestAnimationFrame(() => {
				rafId = 0;
				syncScrollGlassNav();
			});
		};

		syncScrollGlassNav();
		window.addEventListener('scroll', requestNavSync, { passive: true });
		document.body.addEventListener('scroll', requestNavSync, { passive: true });
		window.addEventListener('resize', requestNavSync);
		document.addEventListener('astro:page-load', requestNavSync);
	};

	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener('click', () => setExpanded(menu.hidden));

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			const mediaQueries = window.matchMedia('(min-width: 50em)');
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	if (!customElements.get("menu-button")) {
		customElements.define("menu-button", MenuButton);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initScrollGlassNav, { once: true });
	} else {
		initScrollGlassNav();
	}
</script>

<style>

	nav {
		--nav-scroll-progress: 0;
		--nav-surface-alpha: 0;
		--nav-border-alpha: 0;
		--nav-shadow-alpha: 0;
		--nav-blur-strength: 0;
		min-height: var(--size-top, 64px);
		display: flex;
		z-index: 9999;
		position: relative;
		font-family: var(--font-brand);
		font-weight: 500;
		position: sticky;
		top: 0;
		-webkit-backdrop-filter: saturate(calc(100% + (var(--nav-scroll-progress) * 200%))) blur(calc(var(--nav-blur-strength) * 1px));
		backdrop-filter: saturate(calc(100% + (var(--nav-scroll-progress) * 200%))) blur(calc(var(--nav-blur-strength) * 1px));
		background-color: rgba(var(--color-999-rgb), var(--nav-surface-alpha));
		border-bottom: 1px solid rgba(var(--color-999-rgb), var(--nav-border-alpha));
		box-shadow: 0 18px 48px rgba(15, 23, 42, var(--nav-shadow-alpha));
		transition: background-color 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease, -webkit-backdrop-filter 0.22s ease, backdrop-filter 0.22s ease;
	}
	nav.nav--scrolled {
		border-bottom-color: color-mix(in srgb, var(--border) 78%, transparent);
	}
	.bg-ticker{
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		top: -50px;
		width: 100%;
		height: 100%;
		z-index: -1;
	}
	.menu-header {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0;
	}

	.site-title {
		display: flex;
		gap: 0.5rem;
		justify-content: flex-start;
		align-items: center;
		line-height: 1.1;
		color: var(--color-0);
		font-weight: 400;
		text-decoration: none;
		font-size: 1.5rem;
		letter-spacing: 0.1px;
		&:hover{
			color:rgb(236, 72, 113);
		}
	}
	.author{
		display: inline-flex;
		align-items: center;
		line-height: 1;
	}
	.author--nav-avatar-hidden{
		pointer-events: none;
	}
	.logo {
		max-height: 30px;
	}
	.logo path{
		fill: var(--color-100);
	}
	.avatar{
        display: inline-block;
        position: relative;
        line-height: 1;
        width: 40px;
        height: 40px;
        border-radius: 50%;
		opacity: 1;
		transform: translateY(0) scale(1);
		visibility: visible;
        transition: transform 0.26s ease, opacity 0.26s ease, visibility 0s linear 0s;
    }
	.avatar__img{
		display: block;
		border-radius: 50%;
    }
	.avatar.avatar--home-hidden{
		opacity: 0;
		transform: translateY(-0.35rem) scale(0.92);
		visibility: hidden;
		transition: transform 0.26s ease, opacity 0.26s ease, visibility 0s linear 0.26s;
	}
	.avatar.avatar--home-hidden.avatar--revealed{
		opacity: 1;
		transform: translateY(0) scale(1);
		visibility: visible;
		transition: transform 0.26s ease, opacity 0.26s ease, visibility 0s linear 0s;
	}
	.avatar__name{
		line-height: normal;
		font-weight: 400;
		font-size: 22px;
    }
	@media (prefers-reduced-motion: reduce) {
		.avatar,
		.avatar.avatar--home-hidden,
		.avatar.avatar--home-hidden.avatar--revealed{
			transition: none;
		}
	}
	.nav-wrapper{
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: row;
		align-items: center;
		font-size:1rem;
		font-weight: normal;
		line-height:1;
		list-style: none;
		padding: 0;
		position: relative;
		border: 0;
		gap: calc(var(--gap)*1.5);
	}
	.nav-items li{
		margin:0;
	}
	.link {
		display: inline-block;
		color: var(--color-300);
		text-decoration: none;
	}

	.link.active {
		color: var(--color-100);
		font-weight: bold;
	}

	.menu-footer {
		--icon-size: var(--text-xl);
		--icon-padding: 0.5rem;
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: .35rem 0rem;
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		font-size: var(--icon-size);
	}

	.social {
		display: flex;
		padding: var(--icon-padding);
		text-decoration: none;
		color: var(--accent-dark);
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus {
		color: var(--accent-text-over);
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
	}
	.languages {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
	}

	@media (min-width: 60em) {
		.socials {
			display: flex;
			justify-content: flex-end;
			gap: 0;
		}
	}
	@media (max-width: 576px) {
		.nav-wrapper{
			display: flex;
			align-items: center;
			gap: 0rem;

		}
		.menu-header{
			padding:8px 0;
		}
		.menu-footer{
			padding: 0;
		}
	}
	.pc-nav{
 	 	display: none;
	}
	@media (min-width: 767px) {
		.pc-nav{
			display: flex;
		}
	}
</style>
