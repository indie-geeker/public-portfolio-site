---
import { nav } from '../data/content';
import LocalizedText from './LocalizedText.astro';
import LocaleToggle from './LocaleToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

const isNavItemActive = (href: string) => (
  Astro.url.pathname === href ||
  (href !== '/' && Astro.url.pathname.startsWith(href)) ||
  (href === '/project' && Astro.url.pathname.startsWith('/detail/'))
);
---

<div class="mobile-header">
  <button
    class="hamburger-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-navigation"
    aria-label="打开菜单 / Open menu"
  >
    <span aria-hidden="true"></span>
  </button>

  <div class="m-nav" id="mobile-navigation" aria-hidden="true">
    <div class="m-nav-wrap">
      <ul class="m-menu">
        {nav.items?.map((item) => (
          <li class="m-menu-li">
            <a
              aria-current={isNavItemActive(item.href) ? 'page' : undefined}
              class:list={[
                'm-menu__link',
                {
                  active: isNavItemActive(item.href),
                },
              ]}
              href={item.href}
              target={item.target || '_self'}
            >
              <LocalizedText zh={item.label} en={item.labelEn} />
            </a>
          </li>
        ))}
      </ul>
      <div class="m-nav-tools">
        <LocaleToggle />
        <ThemeToggle />
      </div>
    </div>
  </div>
  <button class="m-nav-mask" type="button" tabindex="-1" aria-label="关闭菜单 / Close menu"></button>
</div>

<script>
  const initMobileNavigation = () => {
    const button = document.querySelector<HTMLButtonElement>('.hamburger-toggle');
    const menu = document.querySelector<HTMLElement>('.m-nav');
    const mask = document.querySelector<HTMLButtonElement>('.m-nav-mask');
    if (!button || !menu || !mask || button.dataset.menuBound === 'true') return;
    button.dataset.menuBound = 'true';

    const setExpanded = (expanded: boolean) => {
      button.setAttribute('aria-expanded', String(expanded));
      button.setAttribute('aria-label', expanded ? '关闭菜单 / Close menu' : '打开菜单 / Open menu');
      menu.setAttribute('aria-hidden', String(!expanded));
      menu.classList.toggle('is-active', expanded);
      mask.classList.toggle('is-active', expanded);
      document.documentElement.classList.toggle('mobile-menu-open', expanded);
      if (expanded) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    button.addEventListener('click', () => setExpanded(button.getAttribute('aria-expanded') !== 'true'));
    mask.addEventListener('click', () => setExpanded(false));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setExpanded(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setExpanded(false);
        button.focus();
      }
    });
  };

  document.addEventListener('astro:page-load', initMobileNavigation);
  initMobileNavigation();
</script>

<style lang="scss">
  .mobile-header { display: none; }

  @media (max-width: 766px) {
    .mobile-header { display: block; }

    .hamburger-toggle {
      position: relative;
      z-index: 10001;
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    .hamburger-toggle span,
    .hamburger-toggle span::before,
    .hamburger-toggle span::after {
      display: block;
      width: 24px;
      height: 2px;
      border-radius: 999px;
      background: var(--color-100);
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .hamburger-toggle span { position: relative; }
    .hamburger-toggle span::before,
    .hamburger-toggle span::after { content: ''; position: absolute; left: 0; }
    .hamburger-toggle span::before { transform: translateY(-8px); }
    .hamburger-toggle span::after { transform: translateY(8px); }
    .hamburger-toggle[aria-expanded='true'] span { background: transparent; }
    .hamburger-toggle[aria-expanded='true'] span::before { transform: rotate(45deg); }
    .hamburger-toggle[aria-expanded='true'] span::after { transform: rotate(-45deg); }

    .m-nav {
      position: fixed;
      z-index: 10000;
      top: 0.75rem;
      right: 0.75rem;
      width: min(22rem, calc(100vw - 1.5rem));
      padding: 4.5rem 1.1rem 1.1rem;
      border: 1px solid var(--border);
      border-radius: 26px;
      background: color-mix(in srgb, var(--color-999) 94%, transparent);
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.18);
      backdrop-filter: blur(18px);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.75rem) scale(0.98);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
    }

    .m-nav.is-active {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .m-menu { list-style: none; margin: 0; padding: 0; }
    .m-menu-li { margin: 0; }

    .m-menu__link {
      display: block;
      padding: 0.9rem 1rem;
      border-radius: 14px;
      color: var(--color-300);
      font-size: 1.15rem;
      text-decoration: none;
    }

    .m-menu__link.active { color: var(--color-100); background: var(--color-800); font-weight: 700; }
    .m-nav-tools { display: flex; align-items: center; gap: 0.75rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border); }

    .m-nav-mask {
      position: fixed;
      inset: 0;
      z-index: 9999;
      border: 0;
      background: rgba(0, 0, 0, 0.26);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease, visibility 0s linear 0.2s;
    }

    .m-nav-mask.is-active { opacity: 1; visibility: visible; transition-delay: 0s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-toggle span,
    .hamburger-toggle span::before,
    .hamburger-toggle span::after,
    .m-nav,
    .m-nav-mask { transition: none; }
  }
</style>
