---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import LocalizedText from './LocalizedText.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<div class="project-grid">
  {projects.map((project, index) => {
    const tags = project.data.tags.slice(0, 3);
    return (
      <a href={`/detail/${project.slug}`} class="project-card">
        <div class="project-card__media">
          <Image src={project.data.cover} alt={`${project.data.title_en || project.data.title} / ${project.data.title}`} loading="lazy" />
          <span class="project-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          {project.data.concept && (
            <span class="project-card__concept"><LocalizedText zh="概念项目" en="Concept project" /></span>
          )}
        </div>
        <div class="project-card__body">
          <div class="project-card__status">
            <LocalizedText zh={project.data.status || '概念占位'} en={project.data.status_en || 'Concept placeholder'} />
          </div>
          <h2>
            <LocalizedText zh={project.data.title} en={project.data.title_en || project.data.title} />
          </h2>
          <p>
            <LocalizedText zh={project.data.description} en={project.data.description_en || project.data.description} />
          </p>
          <div class="project-card__footer">
            <div class="project-card__tags">
              {tags.map((tag, tagIndex) => (
                <span><LocalizedText zh={tag} en={project.data.tags_en[tagIndex] || tag} /></span>
              ))}
            </div>
            <span class="project-card__action"><LocalizedText zh="查看页面" en="View page" /> ↗</span>
          </div>
        </div>
      </a>
    );
  })}
</div>

<style>
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .project-card { display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--border); border-radius: 26px; color: inherit; background: var(--color-white); text-decoration: none; transition: transform .22s ease, border-color .22s ease; }
  :root.theme-dark .project-card { background: var(--color-999); }
  .project-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--color-primary-main) 55%, var(--border)); }
  .project-card__media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--color-900); }
  .project-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .project-card:hover .project-card__media :global(img) { transform: scale(1.025); }
  .project-card__index { position: absolute; top: 1rem; left: 1rem; color: white; font-family: var(--font-type); font-size: .8rem; text-shadow: 0 1px 12px rgba(0,0,0,.5); }
  .project-card__concept { position: absolute; top: 1rem; right: 1rem; padding: .45rem .7rem; border: 1px solid rgba(255,255,255,.45); border-radius: 999px; color: white; background: rgba(10,10,10,.46); backdrop-filter: blur(8px); font-size: .75rem; font-weight: 700; }
  .project-card__body { display: flex; flex: 1; flex-direction: column; padding: 1.35rem; }
  .project-card__status { color: var(--color-400); font-size: .78rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  h2 { margin: .7rem 0 0; font-size: clamp(1.35rem, 3vw, 1.8rem); text-align: left; }
  p { margin: .75rem 0 0; color: var(--color-300); line-height: 1.75; }
  .project-card__footer { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 1.25rem; }
  .project-card__tags { display: flex; flex-wrap: wrap; gap: .4rem; }
  .project-card__tags span { padding: .3rem .55rem; border: 1px solid var(--border); border-radius: 999px; color: var(--color-400); font-size: .72rem; }
  .project-card__action { flex: none; color: var(--color-100); font-size: .85rem; font-weight: 700; }
  @media (max-width: 760px) { .project-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .project-card, .project-card__media :global(img) { transition: none; } }
</style>
