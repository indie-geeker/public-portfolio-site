---
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import PlaceholderPanel from '../components/PlaceholderPanel.astro';
import PostPreview from '../components/PostPreview.astro';
import LocalizedText from '../components/LocalizedText.astro';
import { blogTdk } from '../data/content';
import { getVisibleBlogPosts } from '../data/content-queries';

const posts = await getVisibleBlogPosts();
---

<BlogPostLayout
  title={blogTdk.title || ''}
  titleEn={blogTdk.titleEn || ''}
  description={blogTdk.description || ''}
  descriptionEn={blogTdk.descriptionEn || ''}
  keywords={blogTdk.keywords || ''}
>
  <main class="writing-page">
    <PageIntro
      eyebrow="BUILD NOTES & FIELD LOGS"
      titleZh="写作与笔记"
      titleEn="Writing & notes"
      descriptionZh="记录一个独立开发者如何发现问题、做出取舍、构建原型并复盘结果。文章会保留真实的未完成状态。"
      descriptionEn="Notes on how an independent developer finds problems, makes trade-offs, builds prototypes, and learns from the result—including the unfinished parts."
    />

    <section class="writing-list" aria-labelledby="published-heading">
      <div class="writing-list__heading">
        <h2 id="published-heading"><LocalizedText zh="已发布" en="Published" /></h2>
        <span>{String(posts.length).padStart(2, '0')}</span>
      </div>
      {posts.length > 0 ? posts.map((post) => <PostPreview post={post} />) : (
        <PlaceholderPanel
          titleZh="第一篇构建日志正在编辑"
          titleEn="The first build note is being edited"
          descriptionZh="完成后这里会出现标题、摘要、日期、阅读时间和标签。"
          descriptionEn="The finished entry will show its title, summary, date, reading time, and tags here."
          labelZh="内容占位"
          labelEn="Content placeholder"
        />
      )}
    </section>

    <section class="writing-next" aria-labelledby="next-series-heading">
      <PlaceholderPanel
        titleZh="产品从 0 到 1：计划中的系列"
        titleEn="From zero to one: a planned product series"
        descriptionZh="这个板块预留给需求验证、原型、技术选型、发布和复盘五篇连续文章。"
        descriptionEn="This section is reserved for a five-part series covering validation, prototyping, technical choices, launch, and retrospective."
        labelZh="即将开放"
        labelEn="Coming soon"
      />
    </section>
  </main>
</BlogPostLayout>

<style>
  .writing-page { padding-bottom: 3rem; }
  .writing-list__heading { display: flex; align-items: baseline; justify-content: space-between; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
  .writing-list__heading h2 { margin: 0; font-size: 1.25rem; text-align: left; }
  .writing-list__heading span { color: var(--color-500); font-family: var(--font-type); }
  .writing-next { margin-top: 2rem; }
</style>
