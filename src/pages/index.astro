---
import LatestNotes from "../components/home/LatestNotes.astro";
import FeaturedProducts from "../components/home/FeaturedProducts.astro";
import FollowSection from "../components/home/FollowSection.astro";
import Hero from "../components/home/Hero.astro";
import MiniAbout from "../components/home/MiniAbout.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeTdk } from '../data/content';
import { getFeaturedBlogPosts, getFeaturedProjects } from '../data/content-queries';

const featuredProjects = await getFeaturedProjects(3);
const featuredPosts = await getFeaturedBlogPosts(3);
---

<BaseLayout
title={homeTdk.title || ''}
titleEn={homeTdk.titleEn || ''}
description={homeTdk.description || ''}
descriptionEn={homeTdk.descriptionEn || ''}
keywords={homeTdk.keywords || ''}
>
  <Hero />

  <section
    class="home-section"
    aria-labelledby="featured-products-heading"
    data-particle-gate-start
  >
    <div class="container">
      <FeaturedProducts projects={featuredProjects} />
    </div>
  </section>

  <section class="home-section" id="updates" aria-labelledby="latest-notes-heading">
    <div class="container">
      <LatestNotes posts={featuredPosts} />
    </div>
  </section>

  <section class="home-section" aria-labelledby="mini-about-heading">
    <div class="container">
      <MiniAbout />
    </div>
  </section>

  <section class="home-section" id="follow" aria-labelledby="follow-heading">
    <div class="container">
      <FollowSection />
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .home-section {
    padding: var(--space-home-section) 0;
  }
</style>
