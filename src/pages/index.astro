---
import { getCollection } from 'astro:content';
import LatestNotes from "../components/home/LatestNotes.astro";
import FeaturedProducts from "../components/home/FeaturedProducts.astro";
import FollowSection from "../components/home/FollowSection.astro";
import Hero from "../components/home/Hero.astro";
import MiniAbout from "../components/home/MiniAbout.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeTdk } from '../data/content';
import { isVisibleBlogPost, sortBlogPostsByDateDesc } from '../data/site-utils';

const latestPosts = (await getCollection('blog'))
  .filter(isVisibleBlogPost)
  .sort(sortBlogPostsByDateDesc)
  .slice(0, 3);
---

<BaseLayout
title={homeTdk.title || ''}
description={homeTdk.description || ''}
keywords={homeTdk.keywords || ''}
>
  <Hero />

  <section
    class="home-section"
    aria-labelledby="featured-products-heading"
    data-particle-gate-start
  >
    <div class="container">
      <FeaturedProducts />
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class="home-section" id="updates" aria-labelledby="latest-notes-heading">
      <div class="container">
        <LatestNotes posts={latestPosts} />
      </div>
    </section>
  )}

  <section class="home-section" aria-labelledby="mini-about-heading">
    <div class="container">
      <MiniAbout />
    </div>
  </section>

  <section class="home-section" id="follow" aria-labelledby="follow-heading">
    <div class="container">
      <FollowSection />
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .home-section {
    padding: 1.5rem 0;
  }
</style>
