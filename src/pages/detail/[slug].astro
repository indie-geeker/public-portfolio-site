---
import { getCollection, type CollectionEntry } from 'astro:content';
import DetailPostLayout from "../../layouts/DetailPostLayout.astro";

interface Props {
	entry: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
	const projects = await getCollection('projects');

	return projects
		.filter((entry) => entry.data.draft !== true && !entry.data.detailUrl)
		.map((entry) => ({
			params: { slug: entry.slug },
			props: { entry },
		}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const publishDate = entry.data.publishDate.toISOString().slice(0, 10);
const tags = entry.data.tags ?? [];
const keywords = tags.join(',');
---

<DetailPostLayout
	title={entry.data.title}
	description={entry.data.description}
	keywords={keywords}
>
	<div class="post">
		<main class="post-wrapper">
			<header class="post-header">
				<div class="title-tag">PROJECT</div>
				<h1>{entry.data.title}</h1>
				{entry.data.title_en && <p class="post-subtitle font-type">{entry.data.title_en}</p>}
				<p class="post-summary">{entry.data.description}</p>
				<div class="post-meta">
					<span>{publishDate}</span>
					{entry.data.status && <span>{entry.data.status}</span>}
				</div>
				{tags.length > 0 && (
					<div class="post-tags">
						{tags.map((tag) => <span>{tag}</span>)}
					</div>
				)}
			</header>

			{entry.data.cover && (
				<div class="project-cover">
					<img src={entry.data.cover} alt={entry.data.title} loading="lazy" />
				</div>
			)}

			<section>
				<div class="content">
					<Content />
				</div>
			</section>

			{entry.data.externalUrl && (
				<div class="project-actions">
					<a href={entry.data.externalUrl} target="_blank" rel="noreferrer" class="project-cta">
						立即体验
					</a>
				</div>
			)}
		</main>
	</div>
</DetailPostLayout>

<style>
	.post-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.9rem;
	}

	.title-tag {
		display: inline-block;
		font-size: 13px;
		line-height: 1;
		margin: 16px auto 0;
		border: 1px solid var(--color-700);
		border-radius: 36px;
		padding: 8px 22px 4px;
		color: var(--color-300);
		text-align: center;
		font-family: var(--font-type);
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.post-subtitle,
	.post-summary {
		margin: 0;
		color: var(--color-300);
		text-align: center;
	}

	.post-meta,
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	.post-meta {
		color: var(--color-400);
		font-size: 0.9rem;
	}

	.post-tags span {
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--color-300);
		font-size: 0.8rem;
	}

	.project-cover {
		margin: 0 auto 2rem;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid var(--border);
	}

	.project-cover img {
		display: block;
		width: 100%;
		height: auto;
	}

	.project-actions {
		display: flex;
		justify-content: center;
		margin-top: 2rem;
	}

	.project-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 148px;
		padding: 0.95rem 1.4rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--color-100);
		text-decoration: none;
		font-weight: 600;
	}

	.project-cta:hover {
		border-color: var(--color-primary-main);
	}
</style>
