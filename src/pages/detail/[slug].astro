---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import DetailPostLayout from '../../layouts/DetailPostLayout.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import { getVisibleProjects } from '../../data/content-queries';

interface Props {
  entry: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
  const projects = await getVisibleProjects();
  return projects.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const publishDate = entry.data.publishDate.toISOString().slice(0, 10);
const tags = entry.data.tags ?? [];
const keywords = tags.join(',');
const gallery = entry.data.gallery?.length ? entry.data.gallery : [];
---

<DetailPostLayout
  title={entry.data.title}
  titleEn={entry.data.title_en || entry.data.title}
  description={entry.data.description}
  descriptionEn={entry.data.description_en || entry.data.description}
  keywords={keywords}
>
  <main class="project-detail">
    <a class="project-back" href="/project">← <LocalizedText zh="返回项目实验室" en="Back to project lab" /></a>

    <header class="project-header">
      <div class="project-header__topline">
        <span>PROJECT / {publishDate}</span>
        {entry.data.concept && <span class="concept-badge"><LocalizedText zh="概念项目" en="Concept project" /></span>}
      </div>
      <h1><LocalizedText zh={entry.data.title} en={entry.data.title_en || entry.data.title} /></h1>
      <p class="project-summary"><LocalizedText zh={entry.data.description} en={entry.data.description_en || entry.data.description} /></p>
      <div class="project-meta">
        <span><LocalizedText zh={entry.data.status || '概念占位'} en={entry.data.status_en || 'Concept placeholder'} /></span>
        {tags.map((tag, index) => <span><LocalizedText zh={tag} en={entry.data.tags_en[index] || tag} /></span>)}
      </div>
    </header>

    <div class="project-cover">
      <Image src={entry.data.cover} alt={`${entry.data.title_en || entry.data.title} / ${entry.data.title}`} loading="eager" />
    </div>

    <section class="project-disclosure">
      <strong><LocalizedText zh="页面用途说明" en="What this page represents" /></strong>
      <p><LocalizedText zh="这是用于预览正式案例页结构的概念页面。现有图片和文字用于展示信息层级，不把未验证结果包装成真实成绩。" en="This concept page previews the final case-study structure. Current images and copy demonstrate hierarchy without presenting unvalidated outcomes as real results." /></p>
    </section>

    <section class="project-content" data-locale-copy="zh-CN" lang="zh-CN">
      <Content />
    </section>

    <section class="case-placeholder" data-locale-copy="en" lang="en">
      <p class="case-placeholder__eyebrow">CASE STUDY PLACEHOLDER</p>
      <h2>Case study placeholder</h2>
      <p>The full English case study will replace this structured preview after the concept has real users, measurable feedback, and a release history.</p>
      <div class="case-placeholder__grid">
        <article><span>01</span><h3>Problem</h3><p>The validated user problem and current alternatives will appear here.</p></article>
        <article><span>02</span><h3>Decisions</h3><p>Product, interface, and technical trade-offs will be documented here.</p></article>
        <article><span>03</span><h3>Evidence</h3><p>Usage, feedback, outcomes, and lessons will be added only when they are real.</p></article>
      </div>
    </section>

    {gallery.length > 0 && (
      <section class="project-gallery" aria-label="Project gallery">
        <div class="section-label"><LocalizedText zh="界面与场景预览" en="Interface & scenario preview" /></div>
        {gallery.map((figure) => (
          <div class="project-gallery__item"><Image src={figure} alt={`${entry.data.title_en || entry.data.title} / ${entry.data.title}`} loading="lazy" /></div>
        ))}
      </section>
    )}

    <footer class="project-actions">
      {entry.data.externalUrl ? (
        <a href={entry.data.externalUrl} target="_blank" rel="noreferrer" class="project-cta">
          <LocalizedText zh="访问站点原型" en="Visit product prototype" /> ↗
        </a>
      ) : (
        <span class="project-cta project-cta--disabled" aria-disabled="true"><LocalizedText zh="原型即将开放" en="Prototype coming soon" /></span>
      )}
      <a href="/project" class="project-cta project-cta--secondary"><LocalizedText zh="浏览其他概念" en="Browse other concepts" /></a>
    </footer>
  </main>
</DetailPostLayout>

<style>
  .project-detail { padding: 1.5rem 0 3rem; }
  .project-back { display: inline-flex; margin: .5rem 0 2.5rem; color: var(--color-400); font-size: .9rem; }
  .project-header { display: grid; gap: 1.1rem; padding-bottom: clamp(2rem, 5vw, 3.5rem); }
  .project-header__topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--color-500); font-family: var(--font-type); font-size: .75rem; letter-spacing: .08em; }
  .concept-badge { padding: .4rem .7rem; border: 1px solid var(--border); border-radius: 999px; color: var(--color-300); letter-spacing: 0; }
  h1 { max-width: 18ch; margin: .75rem 0 0; font-size: clamp(2.8rem, 8vw, 6rem); line-height: .98; letter-spacing: -.05em; text-align: left; }
  .project-summary { max-width: 48rem; margin: .5rem 0 0; color: var(--color-300); font-size: 1.1rem; line-height: 1.75; }
  .project-meta { display: flex; flex-wrap: wrap; gap: .5rem; }
  .project-meta span { padding: .4rem .7rem; border: 1px solid var(--border); border-radius: 999px; color: var(--color-400); font-size: .75rem; }
  .project-cover { overflow: hidden; border: 1px solid var(--border); border-radius: 28px; background: var(--color-900); }
  .project-cover :global(img) { display: block; width: 100%; height: auto; }
  .project-disclosure { margin: 1rem 0 3rem; padding: 1rem 1.1rem; border-left: 3px solid var(--color-primary-main); background: color-mix(in srgb, var(--color-primary-main) 5%, transparent); }
  .project-disclosure p { margin: .4rem 0 0; color: var(--color-400); line-height: 1.7; }
  .project-content { color: var(--color-200); line-height: 1.8; }
  .project-content :global(* + *) { margin-top: 1rem; }
  .project-content :global(h2), .project-content :global(h3) { margin-top: 2.2em; }
  .case-placeholder { padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px dashed var(--border); border-radius: 28px; }
  .case-placeholder__eyebrow, .section-label { margin: 0 0 .7rem; color: var(--color-500); font-size: .75rem; font-weight: 700; letter-spacing: .12em; }
  .case-placeholder h2 { margin: 0; font-size: clamp(2rem, 5vw, 3.5rem); }
  .case-placeholder > p:not(.case-placeholder__eyebrow) { max-width: 44rem; margin: 1rem 0 0; color: var(--color-300); line-height: 1.75; }
  .case-placeholder__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin-top: 2rem; }
  .case-placeholder__grid article { padding: 1rem; border: 1px solid var(--border); border-radius: 18px; }
  .case-placeholder__grid span { color: var(--color-500); font-family: var(--font-type); font-size: .75rem; }
  .case-placeholder__grid h3 { margin: 2rem 0 0; }
  .case-placeholder__grid p { margin: .6rem 0 0; color: var(--color-400); line-height: 1.65; }
  .project-gallery { display: grid; gap: 1rem; margin-top: 3rem; }
  .project-gallery__item { overflow: hidden; border: 1px solid var(--border); border-radius: 24px; }
  .project-gallery__item :global(img) { display: block; width: 100%; height: auto; }
  .project-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .project-cta { display: inline-flex; align-items: center; justify-content: center; padding: .9rem 1.2rem; border: 1px solid var(--color-100); border-radius: 999px; color: var(--color-999); background: var(--color-100); font-weight: 700; text-decoration: none; }
  .project-cta--secondary, .project-cta--disabled { border-color: var(--border); color: var(--color-300); background: transparent; }
  .project-cta--disabled { cursor: not-allowed; }
  @media (max-width: 700px) { .case-placeholder__grid { grid-template-columns: 1fr; } .project-header__topline { align-items: flex-start; flex-direction: column; } }
</style>
