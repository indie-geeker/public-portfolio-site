---
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import LocalizedText from '../components/LocalizedText.astro';
import { aboutTdk, nav } from '../data/content';
---

<BlogPostLayout
  title={aboutTdk.title || ''}
  titleEn={aboutTdk.titleEn || ''}
  description={aboutTdk.description || ''}
  descriptionEn={aboutTdk.descriptionEn || ''}
  keywords={aboutTdk.keywords || ''}
>
  <main class="about-page">
    <PageIntro
      eyebrow="SMALL STUDIO, COMPLETE PROCESS"
      titleZh="关于这间独立工作室"
      titleEn="About this indie studio"
      descriptionZh="由一名独立开发者维护的小型产品工作室，负责从问题发现、设计、开发到发布后的完整链路。"
      descriptionEn="A small product studio run by one independent developer, covering the path from problem discovery and design to development and post-launch learning."
    />

    <section class="about-lead" aria-labelledby="about-practice-heading">
      <div class="about-lead__portrait">
        <img src={nav.avatar} alt="IndieGeeker / 独立极客" width="160" height="160" />
        <span><LocalizedText zh="独立开发者" en="Independent developer" /></span>
      </div>
      <div>
        <p class="about-kicker"><LocalizedText zh="我的工作方式" en="How I work" /></p>
        <h2 id="about-practice-heading"><LocalizedText zh="把想法做成可以被真实使用的东西" en="Turning an idea into something people can actually use" /></h2>
        <p><LocalizedText zh="这个网站不是完成品陈列柜，而是一间公开的产品工作室。当前没有成熟商业产品，因此所有示例都会明确标为概念、原型或占位；当真实证据出现时，再用数据、反馈和版本记录替换它们。" en="This site is not a trophy cabinet; it is an open product workshop. There are no mature commercial products yet, so every example is explicitly marked as a concept, prototype, or placeholder. Real evidence, feedback, and release notes will replace them when available." /></p>
      </div>
    </section>

    <section class="capabilities" aria-labelledby="capabilities-heading">
      <div class="section-heading">
        <p>CAPABILITIES</p>
        <h2 id="capabilities-heading"><LocalizedText zh="一个人覆盖的产品链路" en="The product path covered by one maker" /></h2>
      </div>
      <div class="capability-grid">
        <article>
          <span>01</span>
          <h3><LocalizedText zh="发现与验证" en="Discovery & validation" /></h3>
          <p><LocalizedText zh="整理问题、目标用户、替代方案和最小验证方式。" en="Clarify the problem, audience, alternatives, and smallest useful validation." /></p>
          <small><LocalizedText zh="案例占位" en="Case-study placeholder" /></small>
        </article>
        <article>
          <span>02</span>
          <h3><LocalizedText zh="产品与界面" en="Product & interface" /></h3>
          <p><LocalizedText zh="建立信息结构、关键流程、视觉系统和响应式交互。" en="Shape information architecture, core flows, visual systems, and responsive interaction." /></p>
          <small><LocalizedText zh="案例占位" en="Case-study placeholder" /></small>
        </article>
        <article>
          <span>03</span>
          <h3><LocalizedText zh="开发与发布" en="Build & release" /></h3>
          <p><LocalizedText zh="选择合适技术栈，完成实现、质量检查、上线和后续迭代。" en="Choose the right stack, implement, verify, release, and iterate after launch." /></p>
          <small><LocalizedText zh="案例占位" en="Case-study placeholder" /></small>
        </article>
      </div>
    </section>

    <section class="process" aria-labelledby="process-heading">
      <div class="section-heading">
        <p>WORKING LOOP</p>
        <h2 id="process-heading"><LocalizedText zh="当前采用的构建循环" en="The current building loop" /></h2>
      </div>
      <ol>
        <li><span>01</span><strong><LocalizedText zh="找一个具体问题" en="Find one specific problem" /></strong></li>
        <li><span>02</span><strong><LocalizedText zh="做最小可用原型" en="Build the smallest useful prototype" /></strong></li>
        <li><span>03</span><strong><LocalizedText zh="观察真实使用" en="Observe real use" /></strong></li>
        <li><span>04</span><strong><LocalizedText zh="发布证据与复盘" en="Publish evidence and lessons" /></strong></li>
      </ol>
    </section>

    <section class="contact-panel" aria-labelledby="contact-heading">
      <div>
        <p><LocalizedText zh="开放联系" en="Open to conversations" /></p>
        <h2 id="contact-heading"><LocalizedText zh="有具体问题或合作想法？" en="Have a specific problem or collaboration idea?" /></h2>
        <span><LocalizedText zh="邮件入口已经可用，合作案例与服务说明目前仍是占位。" en="Email is available now; collaboration cases and service details remain placeholders." /></span>
      </div>
      <a href="mailto:hello@uiineed.com"><LocalizedText zh="发送邮件" en="Send an email" /> ↗</a>
    </section>
  </main>
</BlogPostLayout>

<style>
  .about-page { padding-bottom: 3rem; }
  .about-lead { display: grid; grid-template-columns: 13rem 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--border); border-radius: 28px; }
  .about-lead__portrait { position: relative; }
  .about-lead__portrait img { display: block; width: 100%; aspect-ratio: 1; border-radius: 50%; object-fit: cover; }
  .about-lead__portrait span { display: inline-flex; margin-top: 1rem; padding: .4rem .65rem; border: 1px solid var(--border); border-radius: 999px; color: var(--color-400); font-size: .75rem; }
  .about-kicker, .section-heading > p { margin: 0 0 .75rem; color: var(--color-500); font-size: .75rem; font-weight: 700; letter-spacing: .14em; }
  .about-lead h2 { margin: 0; font-size: var(--font-size-section-title); text-align: left; }
  .about-lead > div > p:last-child { margin: 1.2rem 0 0; color: var(--color-300); line-height: 1.85; }
  .capabilities, .process { margin-top: clamp(3.5rem, 8vw, 6rem); }
  .section-heading { max-width: 44rem; margin-bottom: 1.5rem; }
  .section-heading h2 { margin: 0; font-size: var(--font-size-section-title); text-align: left; }
  .capability-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .capability-grid article { display: flex; flex-direction: column; min-height: 19rem; padding: 1.35rem; border: 1px dashed var(--border); border-radius: 22px; }
  .capability-grid article > span { color: var(--color-500); font-family: var(--font-type); }
  .capability-grid h3 { margin: 3rem 0 0; font-size: 1.35rem; }
  .capability-grid p { margin: .75rem 0 0; color: var(--color-300); line-height: 1.7; }
  .capability-grid small { margin-top: auto; color: var(--color-500); }
  .process ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .process li { display: grid; grid-template-columns: 5rem 1fr; gap: 1rem; margin: 0; padding: 1.2rem .25rem; border-bottom: 1px solid var(--border); }
  .process li span { color: var(--color-500); font-family: var(--font-type); }
  .contact-panel { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-top: clamp(3.5rem, 8vw, 6rem); padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: 28px; color: white; background: #111827; }
  .contact-panel p { margin: 0 0 .75rem; color: #9ca3af; }
  .contact-panel h2 { margin: 0; color: white; font-size: var(--font-size-section-title); text-align: left; }
  .contact-panel span { display: block; max-width: 42rem; margin-top: .8rem; color: #cbd5e1; line-height: 1.7; }
  .contact-panel a { flex: none; padding: .9rem 1.2rem; border: 1px solid #4b5563; border-radius: 999px; color: white; }
  @media (max-width: 760px) { .about-lead { grid-template-columns: 1fr; } .about-lead__portrait { max-width: 9rem; } .capability-grid { grid-template-columns: 1fr; } .capability-grid article { min-height: 14rem; } .contact-panel { align-items: flex-start; flex-direction: column; } }
</style>
