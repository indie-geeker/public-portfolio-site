---
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import PlaceholderPanel from '../components/PlaceholderPanel.astro';
import ProjectList from '../components/ProjectList.astro';
import LocalizedText from '../components/LocalizedText.astro';
import { projectTdk } from '../data/content';
import { getVisibleProjects } from '../data/content-queries';

const projects = await getVisibleProjects();
---

<BlogPostLayout
  title={projectTdk.title || ''}
  titleEn={projectTdk.titleEn || ''}
  description={projectTdk.description || ''}
  descriptionEn={projectTdk.descriptionEn || ''}
  keywords={projectTdk.keywords || ''}
>
  <main class="project-page">
    <PageIntro
      eyebrow="INDEPENDENT PRODUCT PRACTICE"
      titleZh="项目实验室"
      titleEn="Project lab"
      descriptionZh="这里展示产品从想法、原型到正式发布时会使用的完整页面结构。当前条目均为概念项目或可交互原型，不冒充正式产品。"
      descriptionEn="A working view of how ideas, prototypes, and future launches will be presented. Every current entry is clearly identified as a concept or interactive prototype."
    />

    <aside class="project-disclosure" aria-label="Concept project disclosure">
      <span class="project-disclosure__mark" aria-hidden="true"></span>
      <div>
        <strong><LocalizedText zh="概念项目" en="Concept project" /></strong>
        <p><LocalizedText zh="你可以进入每个详情页查看封面、状态、标签、案例正文、图库和外部演示按钮最终会是什么样子。" en="Open any detail page to preview the final cover, status, tags, case-study body, gallery, and external demo action." /></p>
      </div>
    </aside>

    <section class="project-list" aria-label="Project concepts">
      {projects.length > 0 ? (
        <ProjectList projects={projects} />
      ) : (
        <PlaceholderPanel
          titleZh="第一个产品概念正在形成"
          titleEn="The first product concept is taking shape"
          descriptionZh="这里将展示封面、产品阶段、核心价值和详情入口。"
          descriptionEn="This area will show the cover, product stage, core value, and detail-page entry."
        />
      )}
    </section>

    <section class="project-roadmap" aria-labelledby="roadmap-title">
      <div>
        <p class="project-roadmap__eyebrow">NEXT SLOT</p>
        <h2 id="roadmap-title"><LocalizedText zh="下一个产品位置已保留" en="A slot is reserved for the next product" /></h2>
      </div>
      <p><LocalizedText zh="正式项目出现后，可直接替换这一占位卡，不需要重做页面结构。" en="When a formal project is ready, this placeholder can be replaced without redesigning the page." /></p>
      <span><LocalizedText zh="等待验证" en="Awaiting validation" /></span>
    </section>
  </main>
</BlogPostLayout>

<style>
  .project-page { padding: 0 0 3rem; }
  .project-disclosure { display: flex; gap: 1rem; margin-bottom: 2rem; padding: 1.1rem 1.2rem; border: 1px solid var(--border); border-radius: 18px; background: color-mix(in srgb, var(--color-primary-main) 6%, transparent); }
  .project-disclosure__mark { flex: none; width: .7rem; height: .7rem; margin-top: .35rem; border-radius: 50%; background: var(--color-primary-main); box-shadow: 0 0 0 .35rem color-mix(in srgb, var(--color-primary-main) 15%, transparent); }
  .project-disclosure strong { color: var(--color-100); }
  .project-disclosure p { margin: .3rem 0 0; color: var(--color-300); line-height: 1.7; }
  .project-list { margin: 0; }
  .project-roadmap { display: grid; grid-template-columns: 1fr 1.2fr auto; align-items: center; gap: 1.5rem; margin-top: 1.25rem; padding: 1.35rem; border: 1px dashed var(--border); border-radius: 24px; }
  .project-roadmap__eyebrow { margin: 0 0 .5rem; color: var(--color-500); font-size: .72rem; letter-spacing: .14em; }
  .project-roadmap h2 { margin: 0; font-size: 1.25rem; text-align: left; }
  .project-roadmap > p { margin: 0; color: var(--color-400); line-height: 1.65; }
  .project-roadmap > span { padding: .45rem .7rem; border: 1px solid var(--border); border-radius: 999px; color: var(--color-400); font-size: .75rem; white-space: nowrap; }
  @media (max-width: 760px) { .project-roadmap { grid-template-columns: 1fr; } .project-roadmap > span { justify-self: start; } }
</style>
